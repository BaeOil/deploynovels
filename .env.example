# ============================================================
# DeployNovels Backend — Environment Variables Template
# ============================================================
# ⚠️ คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ⚠️ ห้าม commit .env ขึ้น git เด็ดขาด

# --- App ---
APP_PORT=8080

# --- Database (Supabase Session Pooler — IPv4 compatible) ---
# Project Ref: vbwfesraeptqlifxekms
# Region: ap-northeast-2 (Seoul)
# Pooler: aws-1-ap-northeast-2.pooler.supabase.com:5432
# เปลี่ยน <YOUR_DB_PASSWORD> เป็น password จริง
DATABASE_URL=postgresql://postgres.vbwfesraeptqlifxekms:<YOUR_DB_PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# --- Supabase Storage (S3-compatible) ---
# Project Ref: vbwfesraeptqlifxekms
# S3 Endpoint: https://vbwfesraeptqlifxekms.storage.supabase.co/storage/v1/s3
# Public URL:  https://vbwfesraeptqlifxekms.storage.supabase.co/storage/v1/object/public
# Bucket:      image
# กรอก S3 access key + secret จาก Supabase Dashboard → Project Settings → Storage → S3 Access Keys
MINIO_ENDPOINT=https://vbwfesraeptqlifxekms.storage.supabase.co/storage/v1/s3
MINIO_REGION=ap-northeast-2
MINIO_PUBLIC_ENDPOINT=https://vbwfesraeptqlifxekms.storage.supabase.co/storage/v1/object/public
MINIO_ACCESS_KEY=<YOUR_SUPABASE_S3_ACCESS_KEY>
MINIO_SECRET_KEY=<YOUR_SUPABASE_S3_SECRET_KEY>
MINIO_USE_SSL=true

# --- CORS (Vercel FE domain) ---
# เพิ่ม comma คั่นหลาย domain ได้ เช่น https://your-app.vercel.app,https://your-custom-domain.com
# Wildcard รองรับ: *.vercel.app (สำหรับ preview deployment ของ Vercel)
ALLOWED_ORIGINS=https://*.vercel.app,https://your-app.vercel.app,https://your-custom-domain.com

# --- JWT Secrets (สร้างใหม่สำหรับ production ห้ามใช้ค่าเดิมจาก dev) ---
# ใช้คำสั่ง openssl rand -base64 32 สร้างใหม่
JWT_SECRET=<YOUR_PRODUCTION_JWT_SECRET>
JWT_REFRESH_SECRET=<YOUR_PRODUCTION_JWT_REFRESH_SECRET>