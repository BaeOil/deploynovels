# ============================================================
# Frontend Production Environment (Vercel Build Time)
# ============================================================
# หมายเหตุ: Vite อ่านค่าตอน build ไม่ใช่ตอน runtime
# ถ้าเปลี่ยนค่าเหล่านี้ ต้อง trigger redeploy บน Vercel ใหม่ทุกครั้ง
#
# ตั้งค่าทั้งหมดนี้ใน Vercel Dashboard → Settings → Environment Variables → Production
# (Vercel จะ inject ค่าเหล่านั้นตอน build ไม่ต้อง commit .env.production เข้า repo)
# ไฟล์นี้ทำหน้าที่เป็นเอกสารอ้างอิง + fallback ตอน build ลองในเครื่อง
# ============================================================

# URL ของ backend API (Railway service URL)
# ตัวอย่าง: https://deploynovels-production.up.railway.app
VITE_API_BASE_URL=https://deploynovels-production.up.railway.app

# Host ภายในที่ backend ส่งมาใน URL (ไว้สำหรับ backward compat กรณี BE ยังส่ง internal host มา)
# ตอนนี้ BE ส่ง URL เต็มของ Supabase มาตรงๆ แล้ว ค่านี้จึงไม่ค่อยถูกใช้ แต่เก็บไว้กันพัง)
VITE_MEDIA_INTERNAL_HOST=http://minio:9000

# Host สาธารณะที่ browser เรียกได้จริง (Supabase Storage public base URL)
VITE_MEDIA_PUBLIC_HOST=https://vbwfesraeptqlifxekms.storage.supabase.co/storage/v1/object/public